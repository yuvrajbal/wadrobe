{
  "name": "wadrobe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:shared": "node scripts/migrate-shared-data.mjs",
    "db:seed:spain": "node scripts/seed-spain-trip.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "openai": "6.48.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.21",
      "sharp": "0.35.0"
    }
  }
}
