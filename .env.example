# Server-only. Do not prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Better Auth uses GitHub OAuth and server-side database sessions. Generate the
# secret with `openssl rand -base64 32`. The local OAuth callback is
# http://localhost:3000/api/auth/callback/github.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local Docker database from compose.yaml.
DATABASE_URL=postgres://wardrobe:wardrobe@localhost:5432/wardrobe
DATABASE_SSL=disable

# Use "s3" in shared environments. "local" stores objects outside public/ and
# serves them through the same app delivery route used by S3.
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_LOCAL_DIR=.data/uploads

# Optional: authenticated users.id value used by db:seed:spain.
WARDROBE_USER_ID=

# Required when IMAGE_STORAGE_DRIVER=s3. These names work with AWS S3,
# Cloudflare R2, MinIO, and other S3-compatible providers.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=wardrobe
S3_FORCE_PATH_STYLE=false
